page{background:#f7f5ed;color:#293f33}.garden{padding:36rpx 36rpx 26rpx;max-width:1000rpx;margin:auto}.eyebrow{font-size:17rpx;letter-spacing:3rpx;color:#8d997f;text-align:center;font-weight:600}.hello{text-align:center;font-size:28rpx;font-weight:600;margin:30rpx 0 20rpx}.headline{text-align:center;font-size:48rpx;font-weight:750;line-height:1.5;letter-spacing:-1rpx}.soft{color:#77916b;font-size:43rpx}.intro{text-align:center;color:#7c8875;font-size:24rpx;line-height:1.9;margin:23rpx 0 34rpx}.module{display:block;border:2rpx solid #d5dfc9;border-radius:36rpx;background:#edf2e3;padding:30rpx 32rpx 0;margin:28rpx 0;overflow:hidden}.module-top{display:flex;align-items:center;justify-content:space-between;color:#7c8d72;font-size:18rpx;letter-spacing:1rpx;margin-bottom:23rpx}.pill{border:1rpx solid #cbd7bd;padding:5rpx 16rpx;border-radius:30rpx;letter-spacing:0}.zoo-visual{position:relative;height:280rpx;border-radius:23rpx;background:#dfe9d0;overflow:hidden}.zebra{position:absolute;right:22rpx;top:0;width:280rpx;height:280rpx}.letter{position:absolute;left:38rpx;top:28rpx;font:bold 120rpx Georgia;color:#7e986b}.bubble{position:absolute;left:23rpx;bottom:35rpx;padding:18rpx 22rpx;background:#fffef6;border-radius:20rpx 20rpx 2rpx 20rpx;font-size:27rpx;color:#465e3f;transform:rotate(-4deg)}.cover{width:100%;height:280rpx;display:block;border-radius:23rpx}.module-title{font-size:43rpx;font-weight:700;margin-top:30rpx}.module-sub{font-size:24rpx;font-weight:600;color:#647b56;margin-top:12rpx}.module-description{font-size:23rpx;line-height:1.9;color:#7c8972;margin-top:14rpx}.tags{display:flex;gap:13rpx;margin:26rpx 0 30rpx}.tags text{font-size:20rpx;padding:8rpx 13rpx;border-radius:9rpx;background:#ffffff88;color:#6d805e}.module-action{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #d0dbc3;padding:24rpx 0;font-weight:650;font-size:27rpx}.module-action text{border-radius:50%;background:#4b6b50;color:white;font-size:35rpx;width:55rpx;height:55rpx;line-height:55rpx;text-align:center}.bluey{background:#eaf0f2;border-color:#cddde2}.bluey .module-top,.bluey .module-description{color:#748c94}.bluey .module-sub,.bluey .tags text{color:#597884}.bluey .module-action{border-color:#d0dee2}.bluey .module-action text{background:#4a7380}.welcome-note{border:1rpx dashed #c9d1be;border-radius:24rpx;padding:26rpx;margin:37rpx 0}.welcome-note view{font-size:26rpx;font-weight:600;margin-bottom:12rpx}.welcome-note text{font-size:23rpx;line-height:1.9;color:#87917c}.footer{text-align:center;font-size:21rpx;line-height:2;color:#919c87;margin:30rpx 0}.footer view{font-size:18rpx;color:#a2aa99}.pressed{opacity:.8}
