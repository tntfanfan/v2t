<view class="reader-body">
  <view class="reader-top"><button class="catalog-link" bindtap="openCatalog">‹ 故事目录</button><view class="source-label">● 视频原声</view></view>
  <view class="reader-heading"><view><text class="eyebrow">PAGE {{chapter.label}} / 09</text><text class="chapter-title">{{chapter.title}}</text></view><view class="view-switch"><button class="{{view === 'page' ? 'selected' : ''}}" data-view="page" bindtap="switchView">整页看</button><button class="{{view === 'panel' ? 'selected' : ''}}" data-view="panel" bindtap="switchView">一格看</button></view></view>
  <view class="reading-tip"><text>♪ 点气泡听一句，点画面听整格</text><button bindtap="toggleOutlines">{{outlines ? '隐藏提示' : '可点区域'}}</button></view>
  <view class="art-stage {{outlines ? 'show-outlines' : ''}}" style="padding-top:{{stageRatio}}%;" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchcancel="touchCancel">
    <image wx:if="{{imageVisible}}" class="comic-image" src="{{chapter.image}}" mode="scaleToFill" style="{{imageStyle}}" bindload="imageLoaded" binderror="imageFailed" aria-label="第 {{chapter.number}} 页漫画，当前第 {{current.number}} 格" />
    <view wx:for="{{panelSpots}}" wx:key="number" class="hotspot panel-hotspot {{item.number === current.number ? 'active-panel' : ''}} {{item.number === current.number && status === 'playing' && audioMode === 'panel' ? 'playing-panel' : ''}}" style="{{item.style}}" data-panel="{{item.number}}" bindtap="tapPanel" aria-role="button" aria-label="播放第 {{item.number}} 格完整原声" />
    <view wx:for="{{bubbleSpots}}" wx:key="id" class="hotspot bubble-hotspot {{item.id === selectedId ? 'active-bubble' : ''}}" style="{{item.style}}" data-id="{{item.id}}" catchtap="tapBubble" aria-role="button" aria-label="播放 {{item.label}}" />
    <view wx:if="{{!readyImage}}" class="image-status"><text>{{imageError ? '漫画暂时没有打开' : '正在打开漫画…'}}</text><button wx:if="{{imageError}}" class="small-button" bindtap="retryImage">重新打开</button><text wx:if="{{imageError}}" class="image-help">也可以先用下方台词点读</text></view>
  </view>
  <view class="image-tools"><text>第 {{current.number}} / 54 格</text><button bindtap="previewImage" disabled="{{!readyImage}}">查看整页大图 ↗</button></view>
  <view class="page-turner"><button bindtap="previousPage" disabled="{{chapter.number === 1 || navigating}}">← 上一页</button><picker mode="selector" range="{{pageLabels}}" value="{{pageIndex}}" bindchange="choosePage"><view class="page-picker">{{chapter.number}} / 9 页⌄</view></picker><button bindtap="nextPage" disabled="{{chapter.number === 9 || navigating}}">下一页 →</button></view>
  <view class="listen-card">
    <view class="listen-heading"><text class="eyebrow">LISTEN & SAY</text><view class="pill">第 {{current.number}} 格</view></view>
    <text class="listen-title">听听他们说什么</text>
    <text class="speaker">{{selected ? selected.speaker : '画面声音 · 无对白'}}</text>
    <text class="current-line" selectable="true">{{selected ? selected.text : '这一格没有对白，可以听听音乐和环境音。'}}</text>
    <text wx:if="{{selected.note}}" class="line-note">{{selected.note}}</text>
    <button class="replay-line" bindtap="replayLine">↻ {{selected ? '再听这句话' : '听听画面声音'}}</button>
    <view class="line-list-heading"><text>这一格的台词</text><text>{{lines.length}} 句</text></view>
    <view class="line-list">
      <button wx:for="{{lines}}" wx:key="id" class="line-button {{item.id === selectedId ? 'active-line' : ''}}" bindtap="tapLine" data-id="{{item.id}}" aria-label="播放 {{item.speaker}}：{{item.text}}"><text class="mini-play">▶</text><text>{{item.text}}</text></button>
      <text wx:if="{{!lines.length}}" class="ambient-note">没有对白的时候，也听听故事里的小声音。</text>
    </view>
    <text class="sound-note">熟悉的声音，来自原片。也保留了音乐和小小的笑声。</text>
  </view>
  <view class="reader-footnote">{{storageAvailable ? '阅读位置保存在本机' : '这次没能保存位置，请留意当前页数'}} · 魔法木琴</view>
</view>
<view class="player-bar">
  <view class="player-inner">
    <view class="player-info"><view><text class="player-kind">{{playerKind}}</text><text class="player-message">{{playerMessage}}</text></view><picker mode="selector" range="{{speeds}}" value="{{speedIndex}}" bindchange="speedChanged"><view class="speed-picker">{{speeds[speedIndex]}} ⌄</view></picker></view>
    <view class="transport"><button class="step-button" bindtap="previousPanel" disabled="{{current.number === 1 || navigating}}" aria-label="上一格">‹</button><button class="play-toggle" bindtap="togglePlay" disabled="{{navigating}}"><text class="play-symbol">{{playSymbol}}</text><text>{{playLabel}}</text></button><button class="step-button" bindtap="nextPanel" disabled="{{current.number === 54 || navigating}}" aria-label="下一格">›</button></view>
    <view class="play-progress"><slider min="0" max="1000" value="{{seek}}" disabled="{{!canSeek}}" bindchanging="seekChanging" bindchange="seekChanged" activeColor="#315e61" backgroundColor="#dfe6dd" block-color="#315e61" block-size="14" aria-label="播放进度"/><view class="progress-labels"><text>{{elapsed}}</text><text>{{current.number}} / 54 格</text><text>{{duration}}</text></view></view>
  </view>
</view>
