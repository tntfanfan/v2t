{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "整合网页版: dev",
      "type": "shell",
      "command": ".\\启动整合网页.cmd",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "^\\s*(.+):(\\d+):(\\d+):\\s*(.*)$",
              "file": 1,
              "line": 2,
              "column": 3,
              "message": 4
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "英语小花园",
            "endsPattern": "英语小花园：http://"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "微信小程序: 打开开发者工具",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "& 'C:\\Program Files (x86)\\Tencent\\微信web开发者工具\\cli.bat' open --project '${workspaceFolder}\\frontend\\miniprogram'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
