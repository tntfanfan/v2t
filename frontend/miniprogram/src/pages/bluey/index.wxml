<view class="product-nav"><navigator class="" url="/pages/index/index" open-type="reLaunch">✿ 迎宾首页</navigator><navigator class="" url="/pages/english/index" open-type="reLaunch">英语复习</navigator><navigator class="selected" url="/pages/bluey/index" open-type="reLaunch">Bluey 漫画</navigator></view><view class="home">
  <view class="home-header">
    <view class="brand-row"><view class="brand-mark">b.</view><view><text class="brand-name">Bluey</text><text class="brand-caption">一起看，一起听</text></view></view>
    <view class="pill">● 视频原声</view>
  </view>
  <view class="book-shelf"><button wx:for="{{books}}" wx:key="episode" class="{{catalog.episode === item.episode ? 'chosen' : ''}}" data-episode="{{item.episode}}" bindtap="chooseBook"><text>{{item.episode}}</text><view>{{item.titleZh}}</view></button></view>
  <view class="book-card">
    <view class="book-copy"><text class="eyebrow">{{catalog.episode}}</text><text class="book-title">{{catalog.titleZh}}</text><text class="book-english">{{catalog.title}}</text><view class="book-description"><view>跟着熟悉的声音，一起读故事。</view><view>和 Bluey、Bingo 一起听故事。</view></view></view>
    <image class="book-cover" src="{{catalog.cover}}" mode="aspectFill" aria-hidden="true" />
    <view class="cover-label">{{catalog.pageCount}} 页漫画 · {{catalog.panelCount}} 个画格</view>
  </view>
  <button class="primary start-button" hover-class="button-hover" bindtap="continueReading" loading="{{opening}}" disabled="{{opening}}">{{saved.started ? '继续阅读 · 第 ' + saved.panel + ' 格' : '打开漫画，开始点读'}} <text>→</text></button>
  <view class="home-tools"><button bindtap="showGuide">怎么陪孩子读？ ↗</button><button wx:if="{{saved.started}}" bindtap="startReading">从第一页开始</button><text wx:else>点气泡，听见熟悉的声音</text></view>
  <view class="section-heading"><view><text class="eyebrow">STORY CHAPTERS</text><text class="section-title">故事目录</text></view><text class="muted">选一页，也能开始</text></view>
  <view class="chapter-list">
    <button wx:for="{{catalog.chapters}}" wx:key="number" class="chapter-card {{saved.started && saved.panel >= item.first && saved.panel <= item.last ? 'current-chapter' : ''}}" hover-class="button-hover" data-first="{{item.first}}" bindtap="chooseChapter" disabled="{{opening}}">
      <image class="chapter-thumb" src="{{item.thumbnail}}" mode="aspectFill" />
      <view class="chapter-copy"><text class="chapter-index">PAGE {{item.label}}</text><text class="chapter-name">{{item.title}}</text><text class="chapter-range">第 {{item.first}}–{{item.last}} 格<text wx:if="{{saved.started && saved.panel >= item.first && saved.panel <= item.last}}"> · 上次读到这里</text></text></view><text class="chapter-arrow">↗</text>
    </button>
  </view>
  <view class="home-footer"><text>阅读位置保存在本机</text><button bindtap="showAbout">关于漫画 ↗</button></view>
</view>
