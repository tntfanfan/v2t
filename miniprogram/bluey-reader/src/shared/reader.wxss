.reader-body { max-width: 960rpx; margin: auto; padding: 16rpx 24rpx 334rpx; padding-bottom: calc(334rpx + env(safe-area-inset-bottom)); }
.reader-top { display: flex; justify-content: space-between; align-items: center; padding: 10rpx 4rpx 26rpx; }
.catalog-link { color: #6c817c; font-size: 25rpx; }
.source-label { color: #708c7d; font-size: 21rpx; }
.reader-heading { display: flex; align-items: center; justify-content: space-between; margin: 5rpx 0 20rpx; }
.reader-heading > view:first-child { flex: 1; min-width: 0; margin-right: 20rpx; }
.chapter-title { display: block; font-size: 36rpx; margin-top: 7rpx; font-weight: 650; }
.view-switch { display: flex; padding: 6rpx; border: 1rpx solid #dee4d9; border-radius: 50rpx; background: #eeefe6; flex-shrink: 0; }
.view-switch button { font-size: 23rpx; padding: 12rpx 20rpx; border-radius: 40rpx; }
.view-switch .selected { color: #fff; background: #315e61; }
/* The native v2 button has a fixed default width and automatic margins. */
.reader-body .view-switch { width: 308rpx; }
.reader-body .view-switch button { flex: 1; min-width: 0; width: auto; margin: 0; }
.reader-body button.catalog-link,
.reader-body .reading-tip button,
.reader-body .image-tools button,
.reader-body .page-turner button { width: auto; margin: 0; flex-shrink: 0; }
.reading-tip { display: flex; justify-content: space-between; align-items: center; font-size: 20rpx; color: #87948b; margin: 24rpx 4rpx 14rpx; }
.reading-tip button { font-size: 20rpx; color: #6d867c; padding: 8rpx 0 8rpx 16rpx; }
.art-stage { position: relative; height: 0; width: 100%; overflow: hidden; border-radius: 18rpx; background: #eeede1; box-shadow: 0 5rpx 22rpx #223b3012; }
.comic-image { position: absolute; max-width: none; }
.hotspot { position: absolute; z-index: 1; background: transparent; }
.panel-hotspot { border-radius: 9rpx; }
.bubble-hotspot { z-index: 2; border-radius: 16rpx; }
.show-outlines .panel-hotspot { box-shadow: inset 0 0 0 2rpx #6f999b80; }
.show-outlines .bubble-hotspot { box-shadow: inset 0 0 0 3rpx #d69d36b3; background: #ffd46a14; }
.active-bubble { box-shadow: inset 0 0 0 4rpx #e7ac3a; }
.playing-panel { box-shadow: inset 0 0 0 4rpx #56877c; }
.image-status { position: absolute; inset: 0; z-index: 4; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24rpx; color: #75847c; font-size: 26rpx; background: #f3f1e9ed; }
.image-status button { margin-top: 20rpx; }
.image-help { font-size: 22rpx; margin-top: 15rpx; }
.image-tools { display: flex; justify-content: space-between; padding: 16rpx 4rpx 0; color: #8b988e; font-size: 21rpx; }
.image-tools button { color: #718a80; font-size: 21rpx; }
.page-turner { display: flex; align-items: center; justify-content: space-between; padding: 23rpx 0; margin: 0 4rpx 12rpx; }
.page-turner button { padding: 13rpx 12rpx; border-radius: 16rpx; background: #ecefe4; color: #5d7870; font-size: 24rpx; }
.page-picker { font-size: 22rpx; color: #819088; padding: 14rpx 10rpx; }
.listen-card { margin-top: 14rpx; padding: 28rpx; background: #fffef8; border: 1rpx solid #e4e7dc; border-radius: 26rpx; }
.listen-heading { display: flex; justify-content: space-between; align-items: center; }
.listen-title { display: block; font-size: 33rpx; font-weight: 650; margin: 12rpx 0 26rpx; }
.speaker { display: block; color: #83917f; font-size: 23rpx; }
.current-line { display: block; font-size: 36rpx; line-height: 1.6; margin: 13rpx 0 20rpx; font-family: Georgia, 'Times New Roman', serif; overflow-wrap: break-word; }
.line-note { display: block; color: #a27942; background: #f8efda; font-size: 22rpx; line-height: 1.7; padding: 14rpx; border-radius: 12rpx; margin-bottom: 18rpx; }
.replay-line { width: 100%; border-radius: 20rpx; background: #e8efe8; padding: 20rpx; font-size: 26rpx; color: #426e62; }
.line-list-heading { display: flex; justify-content: space-between; border-top: 1rpx solid #ecece0; margin-top: 30rpx; padding: 26rpx 0 18rpx; font-size: 25rpx; }
.line-list-heading>text:last-child { color: #9aa28f; font-size: 22rpx; }
.line-button { display: flex; text-align: left; align-items: flex-start; width: 100%; padding: 18rpx; border-radius: 16rpx; margin: 6rpx 0; font-size: 28rpx; line-height: 1.6; border: 1rpx solid transparent; }
.line-button .mini-play { color: #81978a; font-size: 19rpx; padding-top: 5rpx; margin-right: 18rpx; flex-shrink: 0; }
.line-button>text:last-child { min-width: 0; overflow-wrap: break-word; }
.active-line { background: #f7efd7; border-color: #ebdab1; }
.sound-note, .ambient-note { display: block; margin-top: 24rpx; color: #98a18f; font-size: 22rpx; line-height: 1.8; }
.reader-footnote { padding: 26rpx 0; text-align: center; font-size: 20rpx; color: #97a18e; }
.player-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; border-top: 1rpx solid #dbe3d8; background: #fffef8; padding-bottom: env(safe-area-inset-bottom); box-shadow: 0 -6rpx 32rpx #27423b09; }
.player-inner { max-width: 960rpx; margin: auto; padding: 18rpx 28rpx 16rpx; }
.player-info { display: flex; justify-content: space-between; align-items: center; }
.player-info>view { min-width: 0; flex: 1; }
.player-kind { display: block; color: #7d8a7c; font-size: 20rpx; }
.player-message { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 22rpx; margin-top: 5rpx; }
.speed-picker { background: #f0f1e8; padding: 13rpx 17rpx; border-radius: 15rpx; font-size: 23rpx; margin-left: 18rpx; }
.transport { display: flex; align-items: center; justify-content: center; margin: 13rpx 0 0; }
.step-button { width: 90rpx; height: 74rpx; font-size: 50rpx; line-height: 66rpx; color: #638176; }
.play-toggle { width: 286rpx; height: 76rpx; background: #315e61; color: #fff; border-radius: 45rpx; display: flex; align-items: center; justify-content: center; font-size: 27rpx; }
.play-symbol { margin-right: 18rpx; font-size: 25rpx; }
.play-progress slider { margin: 3rpx 6rpx 0; height: 43rpx; }
.progress-labels { display: flex; justify-content: space-between; color: #8d9a8a; font-size: 19rpx; line-height: 1.2; }
