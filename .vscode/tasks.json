{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vite: dev",
      "type": "shell",
      "command": ".\\启动Vite调试.cmd",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "^\\s*(.+):(\\d+):(\\d+):\\s*(.*)$",
              "file": 1,
              "line": 2,
              "column": 3,
              "message": 4
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "VITE v",
            "endsPattern": "Local:.*http://"
          }
        }
      ],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
