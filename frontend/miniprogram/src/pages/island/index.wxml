<view class="shell">
 <view class="row"><view class="heading">🏝️ 回忆岛</view><button class="text-button" bindtap="base">‹ 回基地</button></view>
 <block wx:if="{{view==='home'}}">
  <view class="muted">所有单元的老朋友，都在这里。</view>
  <view class="island-hero"><view class="island-art">🏝️</view><view class="heading">{{summary.due?'今天有 '+summary.due+' 个词待复习':hasRound?'接着上次的小回忆吧！':summary.total?'今天的回忆完成啦！':'小岛等着第一个老朋友！'}}</view><view class="muted">{{summary.overdue?'其中 '+summary.overdue+' 个之前没练完，先帮它们回家。':summary.due?'先看图，试着自己拼出来。':nextLabel?'下次复习：'+nextLabel+'。':'先去冒险，学会一个新词吧。'}}</view><button wx:if="{{hasRound || summary.due}}" class="primary" bindtap="start">{{hasRound?'继续回忆 →':'开始回忆 →'}}</button><button wx:else class="primary" bindtap="base">去冒险 →</button><view class="small">每次最多 {{wordCount}} 个词 · 进度自动保存</view></view>
  <view class="card"><view class="strong">给家长：复习节奏</view><view class="paragraph">首次拼对后，明天复习。每次到期独立拼对，下一次间隔逐渐拉长；看答案或拼错后，明天再练。</view><view class="intervals"><text wx:for="{{intervals}}" wx:key="*this">{{item}} 天</text></view><view class="paragraph">从实际复习当天计算，同一天重复练不会跳级；之后保持 30 天。已学词跨单元统一排队，逾期的优先。进入小程序会更新提醒，不发送系统通知。</view></view>
 </block>
 <view wx:elif="{{view==='game' && q}}" class="card island-game"><view class="row"><button class="text-button" bindtap="home">‹ 回忆岛</button><text class="island-progress">{{q.number}} / {{q.total}} 个词</text></view><view class="heading">还记得怎么拼吗？</view><image wx:if="{{q.ready}}" src="{{q.word.image}}" mode="aspectFit"/><view wx:else class="muted">{{mediaError || '正在准备图片…'}}</view><button wx:if="{{mediaError}}" class="secondary" bindtap="prepareWord">重试</button><view class="strong">{{q.word.cn}}</view><view wx:if="{{q.reveal && !q.solved}}" class="hint">看一眼，再自己拼：{{q.word.w}}<button class="text-button" bindtap="cover">藏起答案</button></view><input class="recall-input" value="{{q.draft}}" bindinput="input" maxlength="60" disabled="{{q.solved}}" placeholder="拼出老朋友的名字"/>
  <block wx:if="{{!q.solved}}"><button class="primary" bindtap="answer" disabled="{{!q.ready}}">拼好了 ✓</button><view class="keyboard"><button wx:for="{{keyboard}}" wx:key="*this" data-key="{{item}}" bindtap="key">{{item}}</button><button class="wide" data-key="space" bindtap="key">空格</button><button class="wide" data-key="delete" bindtap="key">⌫ 删除</button></view><view class="actions"><button class="text-button" bindtap="listen" disabled="{{!q.ready}}">听听发音</button><button class="text-button" bindtap="hint">想不起来，看一下</button></view><view wx:if="{{q.notice}}" class="hint">{{q.notice}}</view></block>
  <view wx:else class="feedback"><view class="strong">{{q.notice}}</view><view class="answer">{{q.word.w}}</view><view class="muted">下次：{{q.nextLabel}}</view><button class="primary" bindtap="next">{{q.number===q.total?'收好回忆星 ✦':'下一个朋友 →'}}</button></view>
 </view>
 <view wx:elif="{{view==='result'}}" class="card result"><view class="reward">🏝️</view><view class="heading">{{reward}} 个老朋友，回家啦！</view><view class="reward-text">★ +{{reward}} 颗回忆星</view><view class="muted">{{summary.due?'还有 '+summary.due+' 个词等你复习。':nextLabel?'下次回忆：'+nextLabel+'。':'今天先到这里！'}}</view><view class="actions"><button wx:if="{{summary.due}}" class="primary" bindtap="start">继续回忆 →</button><button class="secondary" bindtap="home">回到小岛</button><button class="secondary" bindtap="base">回基地</button></view></view>
</view>
