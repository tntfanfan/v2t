page { background: #f8f7f0; color: #263e40; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; }
view, button, text, image { box-sizing: border-box; }
button { margin: 0; padding: 0; border-radius: 0; color: inherit; background: transparent; border: 0; line-height: 1.5; font-size: inherit; }
button::after { border: 0; }
button[disabled] { opacity: .35; background: transparent; color: #53686a; }
.primary { background: #315e61; color: #fff; border-radius: 24rpx; padding: 22rpx 28rpx; font-weight: 600; }
.primary[disabled] { background: #315e61; color: #fff; }
.eyebrow { font-size: 20rpx; letter-spacing: 3rpx; color: #82908b; font-weight: 600; }
.muted { color: #7a8985; }
.brand-row { display: flex; align-items: center; }
.brand-mark { width: 76rpx; height: 76rpx; margin-right: 18rpx; border-radius: 24rpx; background: #315e61; color: #f8f7ef; text-align: center; line-height: 76rpx; font-size: 64rpx; font-family: Georgia, serif; font-weight: bold; }
.brand-name { display: block; font-size: 38rpx; font-weight: 750; letter-spacing: -1rpx; }
.brand-caption { display: block; font-size: 20rpx; letter-spacing: 2rpx; color: #798c87; margin-top: 4rpx; }
.pill { padding: 10rpx 17rpx; border: 1rpx solid #dce5df; color: #57736e; border-radius: 40rpx; background: #fffef8; font-size: 22rpx; white-space: nowrap; }
.small-button { padding: 14rpx 18rpx; border-radius: 18rpx; background: #e8efea; color: #315e61; font-size: 24rpx; }
.button-hover { opacity: .75; }

.home { max-width: 900rpx; margin: auto; padding: 26rpx 32rpx 44rpx; }
.home-header { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0 38rpx; }
.book-card { position: relative; border-radius: 32rpx; background: #e5ede4; overflow: hidden; padding: 34rpx 30rpx 0; }
.book-copy { position: relative; z-index: 1; }
.book-title { display: block; font-size: 60rpx; font-weight: 700; letter-spacing: 2rpx; margin-top: 14rpx; }
.book-english { display: block; font: italic 34rpx Georgia, serif; color: #668178; margin-top: 5rpx; }
.book-description { display: block; font-size: 25rpx; line-height: 1.85; color: #76857a; margin: 20rpx 0 26rpx; }
.book-cover { display: block; width: 100%; height: 270rpx; border-radius: 20rpx 20rpx 0 0; object-position: top; }
.cover-label { position: absolute; right: 40rpx; bottom: 20rpx; padding: 10rpx 16rpx; border-radius: 10rpx; background: #fffbed; color: #6b7f76; font-size: 20rpx; }
.start-button { margin-top: 24rpx; display: flex; justify-content: space-between; align-items: center; min-height: 96rpx; }
.start-button text { font-size: 36rpx; }
.home button.start-button { width: 100%; margin: 24rpx 0 0; }
.home button.chapter-card { width: 100%; margin: 16rpx 0; }
.home .home-tools button, .home .home-footer button { width: auto; margin: 0; }
.home-tools { display: flex; justify-content: space-between; margin: 22rpx 0 42rpx; color: #87918a; font-size: 22rpx; }
.home-tools button { font-size: 22rpx; color: #6b8179; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24rpx; }
.section-title { display: block; font-size: 36rpx; font-weight: 650; margin-top: 6rpx; }
.section-heading>.muted { font-size: 22rpx; padding-bottom: 6rpx; }
.chapter-card { display: flex; align-items: center; padding: 18rpx; margin: 16rpx 0; background: #fffef9; border: 2rpx solid #e7e9df; border-radius: 24rpx; text-align: left; }
.chapter-thumb { width: 108rpx; height: 124rpx; border-radius: 12rpx; flex-shrink: 0; }
.chapter-copy { flex: 1; margin-left: 24rpx; }
.chapter-index { display: block; font-size: 19rpx; letter-spacing: 3rpx; color: #96a09a; }
.chapter-name { display: block; font-size: 30rpx; font-weight: 600; margin: 8rpx 0; }
.chapter-range { display: block; font-size: 21rpx; color: #87918a; }
.chapter-arrow { color: #718780; margin: 0 12rpx; }
.current-chapter { border-color: #96b3a4; background: #f1f5eb; }
.home-footer { display: flex; justify-content: space-between; margin: 40rpx 0 14rpx; font-size: 21rpx; color: #9aa399; }
.home-footer button { font-size: 21rpx; color: #718780; }

.module-links {display:flex;justify-content:space-between;gap:16rpx;margin-bottom:20rpx;color:#315e61;font-size:25rpx;}

.book-shelf{display:flex;gap:16rpx;margin:20rpx 0}.book-shelf button{flex:1;width:auto;background:#fffef8;border:1rpx solid #dce5df;border-radius:18rpx;padding:18rpx;font-size:28rpx;text-align:left}.book-shelf button text{font-size:20rpx;color:#708c7d}.book-shelf .chosen{background:#e3eeeb;border-color:#315e61}
