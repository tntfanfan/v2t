<template name="adventure">
<view class="adventure">
 <view class="product-nav"><navigator url="/pages/index/index" open-type="reLaunch">✿ 迎宾首页</navigator><navigator class="selected" url="/pages/english/index" open-type="reLaunch">英语复习</navigator><navigator url="/pages/bluey/index" open-type="reLaunch">Bluey 漫画</navigator></view>
 <view class="shell">
 <view class="brand-row"><navigator url="/pages/english/index" class="brand"><text class="brand-icon">✦</text><view>英语星球冒险<text class="brand-small">BOBO’S LITTLE ADVENTURE</text></view></navigator><text class="star-total">★ {{stars}}</text></view>
 <view class="unit-nav"><button wx:for="{{units}}" wx:key="id" class="unit-tab {{item.selected?'selected':''}}" data-unit="{{item.id}}" bindtap="selectUnit"><text>{{item.icon}}</text><text>U{{item.id}}</text><text class="unit-title">{{item.title}}</text></button></view>
 <view wx:if="{{!storageOK}}" class="notice">本次进度暂时无法保存，请稍后重试。</view>
 <block wx:if="{{view==='home'}}">
  <view class="heading">小队长，一起冒险吧！</view><view class="muted">选个小练习，出发吧！</view>
  <view class="hero"><text class="pill">U{{unit.id}} · {{unit.title}}</text><view class="hero-title">{{roundDone?'这一轮，完成啦！':hasRound?'接着这轮小冒险！':'每轮 5 关，闯关摘星星！'}}</view><view class="actions"><button wx:if="{{!roundDone}}" class="primary" bindtap="start">{{hasRound?'继续冒险 →':'开始冒险 →'}}</button><button wx:else class="primary" bindtap="continueRound">继续冒险 →</button><button wx:if="{{roundDone}}" class="secondary" bindtap="restartRound">重新冒险</button></view><image class="bobo" src="/assets/bobo.png" mode="aspectFit"/>
   <view class="level-box"><view class="row"><text>本轮冒险 · 5 关</text><text class="small">每关 2 题</text></view><view class="levels"><view wx:for="{{levels}}" wx:key="type"><view class="level-icon">{{item.done?'✓':item.icon}}</view><text>{{index+1}}. {{item.name}}</text><text class="small">{{item.solved}} / 2 题</text></view></view></view>
  </view>
  <view class="card"><view class="row"><text class="strong">本单元过关进度</text><text>{{summary.passed}} / {{summary.total}}</text></view><view class="memory-stars"><text wx:for="{{words}}" wx:key="w" class="{{item.passed?'earned':''}}">★</text></view><view class="counts"><view><text>{{summary.passed}}</text> 个词已过关</view><view><text>{{summary.total-summary.passed}}</text> 个词未过关</view></view></view>
  <view class="feature-grid"><button data-view="words" bindtap="navigate">▤ 单词星图<text>看图片，听发音</text></button><button data-view="recordings" bindtap="navigate">♫ 听读小屋<text>词语点读 · 课本录音</text></button><button data-view="collection" bindtap="navigate">✦ 我的徽章<text>点亮十个星球</text></button><button data-view="progress" bindtap="navigate">给爸爸妈妈<text>查看学习进度</text></button></view>
 </block>
 <block wx:elif="{{view==='game'}}">
  <view class="row game-heading"><button class="text-button" data-view="home" bindtap="navigate">‹ 返回基地</button><text wx:if="{{q}}">第 {{q.level}} / 5 关 · 第 {{q.part}} / 2 题</text></view>
  <view wx:if="{{roundDone}}" class="card result"><view class="reward">🌱</view><view class="heading">这一轮的 5 关，全部完成！</view><view class="reward-text">★ 收获 10 颗努力星</view><view class="muted">本单元已有 {{summary.passed}} 个词过关</view><view class="actions"><button class="primary" bindtap="continueRound">继续冒险 →</button><button class="secondary" bindtap="restartRound">重新冒险</button><button class="secondary" data-view="home" bindtap="navigate">回基地</button></view></view>
  <view wx:elif="{{q}}" class="card game-card"><view class="small">{{unit.icon}} {{q.levelName}}</view><view class="heading">{{q.title}}</view>
   <block wx:if="{{q.type==='listen'}}"><view class="muted">先点小喇叭，再选一张图片。</view><button class="primary listen-button" bindtap="listen">◖)) 点我听一听</button><button class="text-button" data-slow="true" bindtap="listen">慢一点听</button></block>
   <block wx:elif="{{q.type==='letter'}}"><view class="target"><image src="{{q.word.image}}" mode="aspectFit"/><text>{{q.word.cn}}</text></view><view class="letters"><text wx:for="{{q.letters}}" wx:key="index" class="letter {{item.space?'space':''}} {{item.blank?'blank':''}}">{{item.value}}</text></view></block>
   <block wx:elif="{{q.type==='hide'}}"><view class="target"><image src="{{q.word.image}}" mode="aspectFit"/><text>{{q.word.cn}}</text></view><view class="letters"><text>{{q.hidePrefix}}</text><text wx:for="{{q.hideLetters}}" wx:key="index" class="letter {{item.found?'found':''}}">{{item.value}}</text><text>{{q.hideSuffix}}</text></view><button wx:if="{{q.phase==='look'}}" class="primary" data-action="hide" bindtap="hide">🙈 把字母藏起来！</button><view wx:else class="keyboard"><button wx:for="{{q.hideKeys}}" wx:key="index" disabled="{{item.disabled}}" data-index="{{item.index}}" data-action="key" bindtap="hide">{{item.value}}</button></view><view wx:if="{{!q.solved && q.phase!=='look'}}" class="actions"><button class="text-button" data-action="undo" bindtap="hide">撤回一个</button><button class="text-button" data-action="peek" bindtap="hide">再看一眼</button></view></block>
   <block wx:elif="{{q.type==='recall'}}"><view class="target"><image src="{{q.word.image}}" mode="aspectFit"/><text>{{q.word.cn}}</text></view><view wx:if="{{q.reveal && !q.solved}}" class="hint">看一遍，再自己拼：{{q.word.w}}</view><input class="recall-input" value="{{q.draft}}" bindinput="onInput" maxlength="60" disabled="{{q.solved}}" placeholder="输入完整单词或短语"/><button class="primary" bindtap="recall" disabled="{{q.solved}}">拼好了 ✓</button><view wx:if="{{!q.solved}}" class="keyboard"><button wx:for="{{keyboard}}" wx:key="*this" data-key="{{item}}" bindtap="key">{{item}}</button><button class="wide" data-key="space" bindtap="key">空格</button><button class="wide" data-key="delete" bindtap="key">⌫ 删除</button></view></block>
   <block wx:elif="{{q.type==='sentence'}}"><view class="muted">{{q.sentence.cn}}</view><image wx:if="{{q.sentenceImage}}" class="sentence-image" src="{{q.sentenceImage}}" mode="aspectFit"/><view wx:else class="sentence-emoji">{{q.sentence.visual}}</view><view class="sentence-line">{{q.sentenceText}}</view></block>
   <view wx:if="{{q.options.length}}" class="choices {{q.type==='listen'?'pictures':''}}"><button wx:for="{{q.options}}" wx:key="index" class="choice {{item.wrong?'wrong':''}} {{item.correct?'correct':''}}" disabled="{{item.disabled}}" data-index="{{item.index}}" bindtap="answer"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><text>{{item.label}}</text></button></view>
   <view wx:if="{{q.solved}}" class="feedback"><view class="strong">{{q.type==='recall'?'拼对啦，过关！':'太棒了，找到啦！'}}</view><view class="answer">{{q.answer}}</view><view wx:if="{{q.type==='sentence'}}" class="muted">{{q.sentence.hint}}</view><button wx:if="{{q.type==='sentence'}}" class="text-button" bindtap="readSentence">◖)) 听听完整句子</button><button class="primary" bindtap="next">{{q.nextText}}</button></view>
   <block wx:else><view wx:if="{{q.notice || q.hint}}" class="hint">{{q.hint?q.hintText:q.notice}}</view><view class="actions"><button wx:if="{{q.type!=='sentence' && q.type!=='listen'}}" class="text-button" bindtap="listen">◖)) 听听这个词</button><button class="text-button" bindtap="hint">💡 看提示</button></view></block>
  </view>
 </block>
 <block wx:else>
  <view class="row section-heading"><view class="heading">{{view==='words'?'单词星图':view==='recordings'?'听读小屋':view==='collection'?'我的记忆徽章':'给爸爸妈妈'}}</view><button class="text-button" data-view="home" bindtap="navigate">‹ 回基地</button></view>
  <view wx:if="{{view==='words'}}" class="word-grid"><button wx:for="{{words}}" wx:key="w" class="word-card" data-index="{{index}}" bindtap="word"><text class="pill {{item.passed?'passed':''}}">{{item.status}}</text><image src="{{item.image}}" mode="aspectFit"/><text class="strong">{{item.cn}}</text><text class="english-word">{{item.revealed?item.w:'点开看单词'}}</text><text class="small">{{item.due}}</text></button></view>
  <block wx:elif="{{view==='recordings'}}"><view class="tabs"><button class="{{recordingTab===0?'selected':''}}" data-tab="0" bindtap="audioTab">词语点读</button><button class="{{recordingTab===1?'selected':''}}" data-tab="1" bindtap="audioTab">课本录音</button></view><view wx:if="{{recordingTab===0}}" class="audio-words"><button wx:for="{{words}}" wx:key="w" data-index="{{index}}" bindtap="word"><image src="{{item.image}}" mode="aspectFit"/><view><text class="english-word">{{item.w}}</text><text class="muted">{{item.cn}}</text></view><text>◖))</text></button></view><block wx:else><view wx:if="{{!lessonAvailable}}" class="notice">课本录音暂未接通。词语点读和句子朗读可以正常使用。</view><view class="card"><view class="strong">{{audio.label || '选一段，听一听'}}</view><view class="muted">{{audio.loading?'正在准备声音…':audio.status==='error'?'声音没有打开，请重试':audio.playing?'正在播放':'点击下方录音开始播放'}}</view><view class="actions"><button class="secondary" bindtap="toggleAudio" disabled="{{!audio.label}}">{{audio.playing?'暂停':'播放'}}</button><picker range="{{['慢一点 · 0.8 倍','正常 · 1 倍','1.2 倍']}}" value="{{speedIndex}}" bindchange="speedChange"><view class="secondary speed">播放速度 ▾</view></picker></view><slider min="0" max="1000" value="{{audio.seek}}" disabled="{{!audio.duration}}" bindchange="seek" activeColor="#377a61"/></view><button wx:for="{{lessons}}" wx:key="src" class="lesson" data-index="{{index}}" bindtap="lesson"><text class="track-number">{{index+1}}</text><view><text>{{item.title}}</text><text class="small">{{item.file}}</text></view><text>▶</text></button></block></block>
  <view wx:elif="{{view==='collection'}}" class="badge-grid"><view wx:for="{{allProgress}}" wx:key="id" class="card badge-card"><text class="badge {{item.earned?'earned':''}}">{{item.earned?item.badge:'✧'}}</text><view class="strong">{{item.badgeName}}</view><view class="muted">已点亮 {{item.passed}} / {{item.total}} 颗星</view><button class="text-button" data-unit="{{item.id}}" bindtap="selectUnit">去{{item.title}} →</button></view></view>
  <block wx:elif="{{view==='progress'}}"><view class="card"><view class="strong">每轮两个词，五关十题</view><view class="paragraph">听一听、补一补、躲猫猫、自己拼、句子挑战。完整拼写正确即显示已过关；以后会按日期安排复习。每个单元分别保存进度，中途退出后还能继续。</view><view class="paragraph">学习记录保存在当前微信中，与网页版分别保存。清空英语学习记录不会改变 Bluey 阅读位置。</view><button class="danger" bindtap="resetProgress">清空英语学习进度</button></view><view wx:for="{{allProgress}}" wx:key="id" class="card"><view class="row"><text class="strong">U{{item.id}} · {{item.title}}</text><text>{{item.passed}} / {{item.total}} 已过关</text></view><view class="muted">今天待复习 {{item.due}} 个词</view><view wx:for="{{item.details}}" wx:for-item="word" wx:key="w" class="word-progress"><text>{{word.w}} · {{word.cn}}</text><text>{{word.status}} · {{word.due}}</text></view></view></block>
 </block>
 <view wx:if="{{audio.status==='error' && (view!=='recordings' || recordingTab===0)}}" class="notice">声音暂时没有播出来，点喇叭重试。</view>
 <view class="footer">一点点练习，一大步发现。</view>
 </view>
</view>
</template>
